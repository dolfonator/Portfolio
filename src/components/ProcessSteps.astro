---
const steps = [
  {
    title: 'Scope',
    time: 'Usually 2-3 days',
    text: 'First, I learn what your business needs to succeed: your offer, your audience, your goals. This gives the build direction from day one.'
  },
  {
    title: 'Build',
    time: 'Usually about a week',
    text: 'I turn that into a secure, responsive site with SEO essentials, structured data, and direct contact routes.'
  },
  {
    title: 'Launch',
    time: 'Same day',
    text: 'I launch a focused first version, then refine the site approriately based on how real visitors actually use it.'
  }
];
---
<ol class="process-list panel">
  {steps.map((step) => (
    <li data-reveal>
      <div>
        <h3>{step.title}</h3>
        <p class="process-time">{step.time}</p>
        <p>{step.text}</p>
      </div>
    </li>
  ))}
</ol>
